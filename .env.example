# For local learning only. Change secrets before any deployment.
JWT_SECRET=replace-with-a-unique-secret-with-32-plus-random-characters
INTERNAL_API_KEY=replace-with-another-unique-long-random-secret
# Each service has an independently owned database.
# Local dev defaults to separate SQLite files under .data/.
# To switch to PostgreSQL set AUTH_DATABASE_URL, STORES_DATABASE_URL,
# CATALOG_DATABASE_URL, INVENTORY_DATABASE_URL, ORDERS_DATABASE_URL,
# DELIVERY_DATABASE_URL, NOTIFICATIONS_DATABASE_URL.
AUTH_SERVICE_URL=http://127.0.0.1:8001
STORES_SERVICE_URL=http://127.0.0.1:8002
CATALOG_SERVICE_URL=http://127.0.0.1:8003
INVENTORY_SERVICE_URL=http://127.0.0.1:8004
ORDERS_SERVICE_URL=http://127.0.0.1:8005
DELIVERY_SERVICE_URL=http://127.0.0.1:8006
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/%2F
